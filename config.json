  "exclude_owner_patterns": {
    "state conservation agency": "FISH (&|AND) W|\\bFWCC?\\b|\\bGFWFC\\b|GAME (&|AND) F|REC (&|AND) PARKS|\\bDNR\\b|FLORIDA FOREVER|NATURAL AREA|STATE PARK",
    "water management or drainage district": "WATER (MANAGEMENT|MGMT|MGT|MANGEMENT|M\\b)|(SOUTH|SO) (FLA|FLORIDA|FL) WATER|\\bSFWMD\\b|DRAINAGE|WATER CONTR|FLOOD CONTROL|CONSERVANCY|IMPROVEMENT DIST|^NORTHERN PALM BEACH COUNTY"
  },
  "exclude_legal_patterns": "SUBMERGED|SUBMRG|\\bSUBM\\b|\\bSUB LAND|BAY BOTTOM|LAKE BOTTOM|RIVER BOTTOM",
  "water_check": {
